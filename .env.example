# ==============================================================================
# VARIABLES DE ENTORNO - HORAS EXTRAS & NÓMINA (VERCEL & SUPABASE)
# ==============================================================================

# 1. SUPABASE (Base de datos PostgreSQL & Autenticación)
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_supabase_anon_key_aqui"

# 2. GOOGLE GEMINI AI (Generación de correos para contabilidad y notas de auditoría)
# Necesaria en Vercel (Environment Variables) o localmente para el endpoint serverless
GEMINI_API_KEY="tu_gemini_api_key_aqui"

# 3. URL DE LA APLICACIÓN (Opcional)
APP_URL="https://tu-app.vercel.app"
